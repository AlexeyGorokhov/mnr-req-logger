{
  "name": "mnr-req-logger",
  "version": "2.0.0",
  "description": "Opinionated wrapper around morgan logger middleware for node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "eslint ./ && npm run tsc",
    "test:integration": "tsx ./test/integration/server/index.ts",
    "test:integration:prod": "NODE_ENV=production tsx ./test/integration/server/index.ts",
    "tsc": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig-build.json && api-extractor run --local --verbose"
  },
  "author": {
    "name": "Alexey Gorokhov",
    "email": "alexey.gorokhov@icloud.com"
  },
  "license": "MIT",
  "dependencies": {
    "morgan": "^1.9.1"
  },
  "devDependencies": {
    "@memnrev/eslint-v9-config": "^0.1.1",
    "@microsoft/api-extractor": "^7.48.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.3",
    "eslint": "^9.8.0",
    "express": "^4.21.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "logger",
    "express",
    "morgan"
  ],
  "homepage": "https://github.com/AlexeyGorokhov/mnr-req-logger",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexeyGorokhov/mnr-req-logger"
  },
  "bugs": {
    "url": "https://github.com/AlexeyGorokhov/mnr-req-logger/issues"
  }
}
